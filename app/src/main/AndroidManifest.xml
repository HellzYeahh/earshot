<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Classic Bluetooth (RFCOMM to the headphones) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- AirPods / Beats battery from their BLE adverts (read-only). Never used to derive location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Foreground service that owns the connection -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Voice memos from the headset shortcut (shortcut/VoiceMemoService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Sound engine and mic check -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Automations: Wi-Fi network name needs location on current Android -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Automations: foreground-app trigger (special access, user grants in Settings) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Per-app profiles need to list launchable apps on Android 11+ -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <!-- Codec switching via Shizuku (user-level, no root) -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- No INTERNET permission on purpose: this app never talks to a server. -->

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Universal remote: a Companion Device Manager link per headset (connect, rename, forget). -->
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />

    <!-- Shortcuts remapper: the assistants it can forward to, and the TextToSpeech engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VOICE_COMMAND" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VOICE_ASSIST" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".EarshotApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Earshot">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Owns the Bluetooth connection and the persistent notification (service/) -->
        <service
            android:name=".service.HeadphoneService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Reconnect when the headphones connect to the phone (service/) -->
        <receiver
            android:name=".service.BluetoothConnectionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.action.LE_AUDIO_CONNECTION_STATE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Attach the EQ to apps that announce their audio session (audio/) -->
        <receiver
            android:name=".audio.AudioSessionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.action.OPEN_AUDIO_EFFECT_CONTROL_SESSION" />
                <action android:name="android.media.action.CLOSE_AUDIO_EFFECT_CONTROL_SESSION" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings tile (extras/tile) -->
        <service
            android:name=".extras.tile.ModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_mode"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="false" />
        </service>

        <!-- Home-screen widget (extras/widget) -->
        <receiver
            android:name=".extras.widget.EarshotWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/earshot_widget_info" />
        </receiver>

        <!-- Scheduled automations (extras/automation) -->
        <receiver
            android:name=".extras.automation.ScheduleReceiver"
            android:exported="false" />

        <!-- Shortcuts remapper (shortcut/): the headset's press-and-hold (HFP voice recognition)
             arrives as VOICE_COMMAND once the user picks Earshot in Android's chooser. No UI.
             Reached only through the aliases below. -->
        <activity
            android:name=".shortcut.ShortcutTriggerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/shortcut_trigger_label"
            android:showWhenLocked="true"
            android:taskAffinity="dev.earshot.shortcut"
            android:theme="@style/Theme.Earshot.Trigger" />

        <!-- Bluetooth headsets' press-and-hold. Disabled until a Controls choice or "Detect a
             button" needs it (shortcut/HeadsetTrigger): a second VOICE_COMMAND handler makes
             Android show its chooser on every headset's next press. -->
        <activity-alias
            android:name=".shortcut.HeadsetTrigger"
            android:enabled="false"
            android:exported="true"
            android:label="@string/shortcut_trigger_label"
            android:targetActivity=".shortcut.ShortcutTriggerActivity">
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Wired / USB-C headsets' long press (locked or screen off). Disabled until the
             experimental switch on the Shortcuts remapper screen enables it. -->
        <activity-alias
            android:name=".shortcut.WiredHeadsetTrigger"
            android:enabled="false"
            android:exported="true"
            android:label="@string/shortcut_trigger_label"
            android:targetActivity=".shortcut.ShortcutTriggerActivity">
            <intent-filter>
                <action android:name="android.speech.action.VOICE_SEARCH_HANDS_FREE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Voice memo recording started by the headset shortcut -->
        <service
            android:name=".shortcut.VoiceMemoService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Shizuku -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
