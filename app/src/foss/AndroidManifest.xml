<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Codec switching via Shizuku (user-level, no root). GitHub build only: the Google Play build
         has no Shizuku (B8, docs/research/play-readiness.md), so none of this is in its manifest. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <!-- The Google Play edition (app ID dev.earshot.foss): only one Earshot should drive a
             headset, so this build notices it (distribution/LegacyApp). The pre-1.0 dev.earshot
             query is in the main manifest, shared by both builds. -->
        <package android:name="dev.earshot.foss" />
        <!-- Shizuku manager: "installed but not running" vs "not installed" (codec/ShizukuPrivilege). -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application>
        <!-- Shizuku hands its binder to the app through this provider (codec/ShizukuPrivilege). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
